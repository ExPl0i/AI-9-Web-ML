# Образец настроек. Скопируйте этот файл в .env (в той же папке server) и замените change_me своим паролем.
# Если файл .env остался с занятия Т4.Б1.4, его можно просто скопировать сюда.
# Файл .env в Git не попадает (он указан в .gitignore), а этот образец попадает – поэтому в нем только заглушка.
# В пароле используйте латинские буквы и цифры: другие символы в строке подключения пришлось бы кодировать.

# Пароль роли pokrytie (для варианта Б: контейнер Docker создает роль с этим паролем)
POSTGRES_PASSWORD=change_me

# Строки подключения: postgresql://пользователь:пароль@адрес:порт/база
DATABASE_URL=postgresql://pokrytie:change_me@127.0.0.1:5432/pokrytie
TEST_DATABASE_URL=postgresql://pokrytie:change_me@127.0.0.1:5432/pokrytie_test

# Файлы моделей. По умолчанию – model/model.joblib и model/model_v2.joblib в папке server.
# MODEL_PATH=model/model.joblib
